generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Authentificated user model
model AuthUser {
  id          String    @id @default(cuid())
  clerkId     String    @unique
  fullName    String
  username    String?   @unique
  email       String    @unique
  rang        UserRange @default(D)
  isCertified Boolean   @default(false)
  isActive    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  theme       String    @default("light")

  events Event[]
}

model User {
  id            String   @id @default(cuid())
  fullName      String
  username      String   @unique
  email         String   @unique
  password      String
  bio           String?
  avatar        String?
  avatarId      String?
  country       String?
  city          String?
  age           Int?
  eventId       String?
  event         Event?   @relation(fields: [eventId], references: [id])
  role          UserRole @default(CANDIDATE)
  isVerified    Boolean  @default(false)
  isBlocked     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  medias        Media[]
  // participations Participation[]
  votesReceived Vote[]   @relation("VotesReceived")

  @@index([eventId])
}

model Event {
  id           String      @id @default(cuid())
  ownerId      String?
  title        String
  description  String
  coverImage   String?
  coverImageId String?
  startDate    DateTime
  endDate      DateTime
  status       EventStatus @default(DISABLED)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  owner        AuthUser?   @relation(fields: [ownerId], references: [id])
  // participations Participation[]
  votes        Vote[]
  users        User[]
  comments     Comment[]

  @@index([status])
  @@index([startDate, endDate])
}

model Comment {
  id          String   @id @default(cuid())
  description String
  voterIp     String
  eventId     String
  createdAt   DateTime @default(now())

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vote   Vote?   @relation(fields: [voteId], references: [id])
  voteId String?

  @@index([eventId])
}

